    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Cortina (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -293.0,
            "y": -14.0,
            "width": 196.0,
            "height": 262.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "44a2005ec18f46fa9eb10e6580340e61"
        },
        {
            "m_Id": "f1ce5dad746d48368e91b7a27fd75ed5"
        },
        {
            "m_Id": "291bbf19e5544fa2b6f3a60ac8e355b0"
        },
        {
            "m_Id": "d8a38245a0674e1ba8ab73bbadd2ad7f"
        },
        {
            "m_Id": "02efbb0bec5d447da30286d903ce7245"
        },
        {
            "m_Id": "74158550c6054092bff8a62817788b7f"
        },
        {
            "m_Id": "fc398da38def4e438ff452966a4c365e"
        },
        {
            "m_Id": "7b41a0395364481aa924acd5337a2b20"
        },
        {
            "m_Id": "f7055d642c314d939492fb9077fbd61e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Cortina",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float altura = saturate((Topo - Pos.z) / max(Altura, 0.001));\r\nfloat mask = pow(altura, 1.5);\r\n\r\nfloat onda = sin(T * Vel + Pos.z * FreqV + Pos.x * FreqH);\r\n\r\nOut = Pos + float3(onda * Forca * mask, 0, 0);"
}

