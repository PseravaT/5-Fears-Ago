  icone: {fileID: 21300000, guid: dee745610072e144b9c610c14cba0583, type: 3}
  descricaoCurta: "Um rel\xF3gio com uma carta ..."
  modelo3D: {fileID: 3148955172299530292, guid: 3383c3a9cc82c1941a4b0e4f1a9a6cd5, type: 3}
