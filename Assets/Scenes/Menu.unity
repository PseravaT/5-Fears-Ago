  grupoMenu: {fileID: 64079222}
  painelDialogo: {fileID: 1498443019}
  fade: {fileID: 1178174242}
  legenda: {fileID: 1687650930}
  visor: {fileID: 1248215846}
  fonte: {fileID: 523347427}
  toque: {fileID: 8300000, guid: 248b0a143596b1c499729f235cf7ae4b, type: 3}
  mensagem: {fileID: 8300000, guid: 46f96c0354003854491745d604154000, type: 3}
  fadeBotao: 1.3
  tempoToque: 8
  pausaAntesMensagem: 1.2
  fadePainel: 0.6
  duracaoSemAudio: 5
  pausaAposMensagem: 3
  duracaoFade: 1.5
  cenaJogo: atual
  legendas:
  - tempo: 0
    texto: "Boa noite, senhor Marcio. Aqui \xE9 o doutor Ricardo Almeida."
  - tempo: 4
    texto: "Sou o advogado respons\xE1vel pelo processo da casa dos seus pais."
  - tempo: 8
    texto: "Como n\xE3o consegui falar com o senhor, estou deixando esta mensagem."
  - tempo: 12
    texto: "A prefeitura aprovou a demoli\xE7\xE3o do im\xF3vel."
  - tempo: 15
    texto: "A ordem j\xE1 foi assinada, e as m\xE1quinas devem chegar na pr\xF3xima
      semana."
  - tempo: 20
    texto: "Ainda existe um prazo para recurso, mas ele est\xE1 acabando."
  - tempo: 24
    texto: "Por favor, retorne esta liga\xE7\xE3o o quanto antes."
  - tempo: 28
    texto: "O senhor pode me encontrar neste mesmo n\xFAmero."
  - tempo: 31
    texto: Aguardo o seu retorno. Obrigado.
