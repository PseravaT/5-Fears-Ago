  rotacaoInicial: {x: -90, y: 0, z: 0}
  posicaoInicial: {x: 0, y: 0, z: 0}
  textoDetalhado: "Foto Tirada de Pai, M\xE3e e Eu."
  textoDetalhadoDano1Laranja: "Foto Tirada de Pai, M\xE3e e Eu."
  textoDetalhadoDano2Vermelho: "Foto Tirada de Pai, M\xE3e e Eu."
  dialogoAntesDeInspecionar: "Minha parte favorita do dia era escutar os antigos
    LPs do meu av\xF4."
  dialogoDano1Laranja: "Eles nunca prestavam aten\xE7\xE3o quando eu vinha falar
    dos meus LPs favoritos."
  dialogoDano2Vermelho: "Nunca fui escutado, nunca me deram aten\xE7\xE3o, nunca
    se importaram comigo! | Nem quando eu fazia minha coisa favorita, que era escutar
    os LPs, eu era importante para eles!"
